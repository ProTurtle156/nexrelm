{
  "name": "@nexrelm/control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Nexrelm control plane — REST + WebSocket daemon that orchestrates network modules via adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "start": "NODE_OPTIONS=--experimental-sqlite tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-sqlite NEXRELM_DATA=$(mktemp -d /tmp/nexrelm-test.XXXXXX) tsx --test --test-concurrency=1 src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@nexrelm/types": "*",
    "dns-packet": "^5.6.1",
    "fastify": "^4.28.1",
    "ldapts": "^7.4.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^20.14.15",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
