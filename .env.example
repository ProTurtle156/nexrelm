# ───────────────────────────── Nexrelm environment ─────────────────────────────
# These have sensible defaults — you only need a .env to override them. The
# installer (deploy/install-nexrelm.sh) wires the important ones for you.

# ── Control plane (apps/control-plane) ──────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# Lock this down to your GUI origin in production (bearer-auth still applies).
CORS_ORIGIN=*

# Where state lives (auth.json, *.db, settings, TLS). Relocate with `nexrelm move-data`.
# NEXRELM_DATA=/home/youruser/.nexrelm

# ── TLS (optional) ──────────────────────────────────────────────────────────────
# The control plane serves HTTPS automatically when a cert + key exist. Generate
# a self-signed pair with `nexrelm gen-cert` (defaults to <data-dir>/tls/), or
# point at your own:
# NEXRELM_TLS_CERT=/path/to/cert.pem
# NEXRELM_TLS_KEY=/path/to/key.pem

# ── Web GUI (apps/web) ──────────────────────────────────────────────────────────
# The origin the browser uses to reach the control plane. Set to your LAN IP /
# hostname for remote access (use https:// if TLS is on), then rebuild the GUI.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws
